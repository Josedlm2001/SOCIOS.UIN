<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UINGO Socio - Control de Servicios por Tiempo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            400: '#38bdf8',
                            500: '#0284c7',
                            600: '#0369a1',
                        },
                        amberCustom: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .glow-amber {
            box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.25);
        }
        .glow-emerald {
            box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.25);
        }
        .glow-rose {
            box-shadow: 0 0 25px -5px rgba(244, 63, 94, 0.3);
        }
        .animate-pulse-slow {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-full flex flex-col justify-between font-sans antialiased selection:bg-amber-500 selection:text-slate-950">

    <!-- Supabase Config Initialization -->
    <script>
        const SUPABASE_URL = 'https://tlcbhbigtxhalgebrwqk.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_bigBIqjdy-EfvKtxS349yA_RcKqFrOA';
        const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    </script>

    <!-- Header Navbar -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-30 shadow-md backdrop-blur-md bg-opacity-90">
        <div class="max-w-2xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-500 text-slate-950 font-black text-xl px-3 py-1 rounded-xl tracking-wider shadow-md">
                    UINGO
                </div>
                <div class="border-l border-slate-800 pl-3">
                    <h1 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Panel de Socios</h1>
                    <p class="text-[10px] font-semibold text-slate-400">Control de Tiempo Local</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-2 bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-full text-right">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[11px] font-extrabold text-slate-300">CDMX / GDL</span>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-2xl mx-auto px-4 py-6 w-full flex-grow flex flex-col justify-center">

        <!-- VISTA 1: CONFIGURACIÓN E INICIO DE SERVICIO -->
        <section id="setupSection" class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
            <div class="text-center pb-2 border-b border-slate-800/80">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-amber-500/10 text-amber-500 rounded-2xl mb-2 border border-amber-500/20">
                    <i class="fa-solid fa-truck-clock text-xl"></i>
                </div>
                <h2 class="text-xl font-extrabold text-white">Iniciar Registro de Servicio</h2>
                <p class="text-slate-400 text-xs mt-1">Ingresa los datos antes de iniciar la marcación por tiempo.</p>
            </div>

            <form id="serviceForm" onsubmit="event.preventDefault(); startService();" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Socio / Chofer *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500">
                                <i class="fa-solid fa-id-card text-sm"></i>
                            </span>
                            <input type="text" id="driverName" required placeholder="Ej. Carlos Mendoza" class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-10 pr-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Nombre del Cliente *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500">
                                <i class="fa-solid fa-user text-sm"></i>
                            </span>
                            <input type="text" id="clientName" required placeholder="Ej. Roberto Gómez" class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-10 pr-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition">
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Fecha del Servicio *</label>
                        <input type="date" id="serviceDate" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Tipo de Vehículo *</label>
                        <select id="vehicleType" onchange="updateVehicleRatesNotice()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-amber-400 font-bold focus:outline-none focus:border-amber-500 transition">
                            <option value="camioneta">Camioneta 1.2T — $312 / 30 min</option>
                            <option value="camion">Camión 3T — $936 / 30 min</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Tiempo Solicitado *</label>
                        <select id="contractedBlocks" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white font-semibold focus:outline-none focus:border-amber-500 transition">
                            <option value="1">30 Minutos (1 bloque)</option>
                            <option value="2">1 Hora (60 min)</option>
                            <option value="3">1 Hora 30 Minutos (90 min)</option>
                            <option value="4">2 Horas (120 min)</option>
                            <option value="5">2 Horas 30 Minutos</option>
                            <option value="6">3 Horas (180 min)</option>
                            <option value="8">4 Horas (240 min)</option>
                            <option value="10">5 Horas (300 min)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Cargadores Extras</label>
                        <select id="extraHelpers" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition">
                            <option value="0">Solo Chofer (Incluido)</option>
                            <option value="1">1 Ayudante Extra ($200/hr)</option>
                            <option value="2">2 Ayudantes Extras ($400/hr)</option>
                            <option value="3">3 Ayudantes Extras ($600/hr)</option>
                        </select>
                    </div>
                </div>

                <!-- Aviso Informativo de Reglas de Cobro -->
                <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl text-xs text-amber-200 space-y-1.5">
                    <p class="font-bold text-amber-400 flex items-center gap-2 text-xs">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Regla Oficial UINGO de Medición de Tiempo:
                    </p>
                    <p class="leading-relaxed">
                        • El cronómetro debe iniciarse exactamente al <strong class="text-white">llegar la unidad a la ubicación</strong>.
                    </p>
                    <p class="leading-relaxed">
                        • Se incluyen automáticamente <strong class="text-white">5 minutos de cortesía</strong> al inicio y al final antes de computar recargos.
                    </p>
                    <p class="leading-relaxed">
                        • Transcurrido el límite, el cobro excedente es estrictamente proporcional: <span id="rateNoticeText" class="font-bold text-amber-400">$10.40/min (Camioneta)</span>.
                    </p>
                </div>

                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-4 px-6 rounded-2xl shadow-xl transition-all duration-200 transform active:scale-95 flex items-center justify-center space-x-2 text-base glow-emerald">
                    <i class="fa-solid fa-play text-lg"></i>
                    <span>LLEGADA A UBICACIÓN - INICIAR CRONÓMETRO</span>
                </button>
            </form>
        </section>

        <!-- VISTA 2: PANEL DE CRONÓMETRO ACTIVO -->
        <section id="activeTimerSection" class="hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 text-center">
            <!-- Header Status -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                <div class="flex items-center space-x-2">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Servicio en Curso</span>
                </div>
                <div class="text-right">
                    <span class="text-[10px] text-slate-400 uppercase block font-bold">Llegada</span>
                    <span id="displayStartTime" class="text-xs font-black text-amber-400 font-mono">-</span>
                </div>
            </div>

            <!-- Ficha de Datos Rápidos -->
            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 text-left text-xs grid grid-cols-2 gap-3">
                <div>
                    <span class="text-slate-500 block text-[10px] font-bold uppercase">Cliente</span>
                    <strong id="displayClientName" class="text-white text-sm font-bold truncate block">-</strong>
                </div>
                <div>
                    <span class="text-slate-500 block text-[10px] font-bold uppercase">Chofer</span>
                    <strong id="displayDriverName" class="text-white text-sm font-bold truncate block">-</strong>
                </div>
                <div>
                    <span class="text-slate-500 block text-[10px] font-bold uppercase">Vehículo</span>
                    <strong id="displayVehicleName" class="text-amber-400 font-bold block">-</strong>
                </div>
                <div>
                    <span class="text-slate-500 block text-[10px] font-bold uppercase">Contratado</span>
                    <strong id="displayContractedTime" class="text-emerald-400 font-bold block">-</strong>
                </div>
            </div>

            <!-- Display de Reloj en Vivo -->
            <div id="clockContainer" class="bg-slate-950 border-2 border-slate-800 rounded-3xl p-6 sm:p-8 shadow-inner transition-colors duration-300">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Tiempo Transcurrido</p>
                <div id="timerDisplay" class="text-5xl sm:text-6xl font-black text-white tracking-wider font-mono my-2">
                    00:00:00
                </div>
                <div id="cortesiaBadge" class="inline-flex items-center space-x-1.5 mt-3 bg-blue-500/20 text-blue-400 border border-blue-500/40 text-xs font-bold px-3.5 py-1.5 rounded-full">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                    <span>Tolerancia Activa (5 min cortesía)</span>
                </div>
            </div>

            <!-- Panel Dinámico de Excedente -->
            <div id="overtimeCard" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 text-xs space-y-2">
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">Tiempo Límite (+5m Cortesía):</span>
                    <span id="displayAllowedTime" class="font-bold text-slate-200 font-mono">-</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">Minutos Excedidos:</span>
                    <span id="extraMinutesText" class="font-black text-slate-200 text-sm">0 min</span>
                </div>
                <div class="pt-2 border-t border-slate-800/80 flex justify-between items-center">
                    <span class="text-slate-300 font-bold">Recargo Extra Estimado:</span>
                    <span id="extraCostText" class="font-black text-base text-slate-200">$0.00 MXN</span>
                </div>
            </div>

            <button onclick="finishService()" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-extrabold py-4 px-6 rounded-2xl shadow-xl transition-all duration-200 transform active:scale-95 flex items-center justify-center space-x-2 text-base glow-rose">
                <i class="fa-solid fa-flag-checkered text-lg"></i>
                <span>FINALIZAR TRABAJO Y GENERAR COBRO</span>
            </button>
        </section>

        <!-- VISTA 3: RESUMEN FINAL Y TRANSPARENCIA DE PAGO -->
        <section id="finalSummarySection" class="hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
            <div class="text-center pb-2 border-b border-slate-800">
                <div class="w-14 h-14 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-2 text-2xl border border-emerald-500/30">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h3 class="text-2xl font-black text-white">Servicio Concluido</h3>
                <p class="text-slate-400 text-xs mt-1">Desglose de transparencia total para Cliente y Socio</p>
            </div>

            <!-- Tabla Resumen -->
            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5 text-xs space-y-3">
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Vehículo Utilizado:</span>
                    <span id="summaryVehicle" class="font-bold text-amber-400">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Hora de Llegada (Inicio):</span>
                    <span id="summaryStartTime" class="font-bold text-white font-mono">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Hora de Cierre (Final):</span>
                    <span id="summaryEndTime" class="font-bold text-white font-mono">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Transcurrido Real:</span>
                    <span id="summaryTotalDuration" class="font-black text-amber-400 text-sm font-mono">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Solicitado Contratado:</span>
                    <span id="summaryContractedTime" class="font-bold text-white">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Tolerancia Aplicada:</span>
                    <span class="font-bold text-blue-400">5 Minutos Cortesía</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Extra Cobrable:</span>
                    <span id="summaryExtraMinutes" class="font-extrabold text-rose-400">-</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Cobro Base Inicial:</span>
                    <span id="summaryBasePrice" class="font-bold text-white">$0.00 MXN</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Ayudantes Extras:</span>
                    <span id="summaryHelpersPrice" class="font-bold text-white">$0.00 MXN</span>
                </div>
                <div class="flex justify-between pb-2.5 border-b border-slate-800">
                    <span class="text-slate-400">Recargo por Tiempo Extra:</span>
                    <span id="summaryExtraCost" class="font-extrabold text-rose-400">$0.00 MXN</span>
                </div>
                <div class="flex justify-between items-center text-sm pt-2">
                    <span class="font-black text-white text-base">TOTAL A COBRAR:</span>
                    <span id="summaryGrandTotal" class="font-black text-emerald-400 text-2xl font-mono">$0.00 MXN</span>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="space-y-3">
                <button onclick="sendWhatsAppReport()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-4 px-6 rounded-2xl shadow-xl transition flex items-center justify-center space-x-2 text-sm glow-emerald">
                    <i class="fa-brands fa-whatsapp text-xl"></i>
                    <span>ENVIAR REPORTE OFICIAL A WHATSAPP UINGO</span>
                </button>

                <button onclick="resetApp()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3.5 px-6 rounded-2xl transition text-xs flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>Registrar Nuevo Servicio</span>
                </button>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-4 text-center text-[11px] text-slate-500">
        <div class="max-w-2xl mx-auto px-4">
            <p>UINGO Logística & Fletes © 2026. Plataforma Operativa de Socios. Colima & Jalisco, México.</p>
        </div>
    </footer>

    <!-- LÓGICA DE JAVASCRIPT UNIFICADA Y COMPLETA -->
    <script>
        let startTime = null;
        let endTime = null;
        let timerInterval = null;
        let serviceData = {};

        // Reglas de tarifa por tipo de vehículo
        const ratesConfig = {
            camioneta: {
                name: 'Camioneta (1.2 Toneladas)',
                rate30Min: 312,
                perMin: 312 / 30 // $10.40 / min
            },
            camion: {
                name: 'Camión (3 Toneladas)',
                rate30Min: 936,
                perMin: 936 / 30 // $31.20 / min
            }
        };

        window.onload = function() {
            // Asignar fecha por defecto de hoy
            const dateInput = document.getElementById('serviceDate');
            if (dateInput) {
                const today = new Date();
                const yyyy = today.getFullYear();
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const dd = String(today.getDate()).padStart(2, '0');
                dateInput.value = `${yyyy}-${mm}-${dd}`;
            }
            updateVehicleRatesNotice();
        };

        function updateVehicleRatesNotice() {
            const vehicle = document.getElementById('vehicleType').value;
            const noticeEl = document.getElementById('rateNoticeText');
            if (vehicle === 'camioneta') {
                noticeEl.innerText = '$10.40/min ($312 cada 30 min)';
            } else {
                noticeEl.innerText = '$31.20/min ($936 cada 30 min)';
            }
        }

        function startService() {
            const driver = document.getElementById('driverName').value.trim();
            const client = document.getElementById('clientName').value.trim();
            const date = document.getElementById('serviceDate').value;
            const vehicle = document.getElementById('vehicleType').value;
            const blocks = parseInt(document.getElementById('contractedBlocks').value);
            const helpers = parseInt(document.getElementById('extraHelpers').value);

            if (!driver || !client || !date) {
                alert("Por favor completa todos los campos requeridos.");
                return;
            }

            startTime = new Date(); // Captura hora exacta del dispositivo (México GDL/CDMX)

            const config = ratesConfig[vehicle];
            const contractedMins = blocks * 30;

            serviceData = {
                driver,
                client,
                date,
                vehicle,
                vehicleName: config.name,
                blocks,
                helpers,
                contractedMinutes: contractedMins,
                allowedMinutes: contractedMins + 5, // 5 min de cortesía incluidos
                rate30Min: config.rate30Min,
                perMinRate: config.perMin,
                startTimeFormatted: startTime.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
            };

            // Rellenar ficha en cronómetro
            document.getElementById('displayClientName').innerText = client;
            document.getElementById('displayDriverName').innerText = driver;
            document.getElementById('displayVehicleName').innerText = config.name;
            document.getElementById('displayStartTime').innerText = serviceData.startTimeFormatted;
            document.getElementById('displayContractedTime').innerText = `${contractedMins} min`;
            document.getElementById('displayAllowedTime').innerText = `${serviceData.allowedMinutes} min`;

            // Cambiar de pantalla
            document.getElementById('setupSection').classList.add('hidden');
            document.getElementById('activeTimerSection').classList.remove('hidden');

            // Iniciar reloj en vivo
            timerInterval = setInterval(updateTimerDisplay, 1000);
            updateTimerDisplay();
        }

        function updateTimerDisplay() {
            const now = new Date();
            const diffMs = now - startTime;
            const totalSecs = Math.floor(diffMs / 1000);

            const hrs = String(Math.floor(totalSecs / 3600)).padStart(2, '0');
            const mins = String(Math.floor((totalSecs % 3600) / 60)).padStart(2, '0');
            const secs = String(totalSecs % 60).padStart(2, '0');

            document.getElementById('timerDisplay').innerText = `${hrs}:${mins}:${secs}`;

            const elapsedMins = Math.floor(totalSecs / 60);

            const clockContainer = document.getElementById('clockContainer');
            const cortesiaBadge = document.getElementById('cortesiaBadge');
            const extraMinutesText = document.getElementById('extraMinutesText');
            const extraCostText = document.getElementById('extraCostText');

            if (elapsedMins > serviceData.allowedMinutes) {
                const extraMins = elapsedMins - serviceData.allowedMinutes;
                const extraCost = extraMins * serviceData.perMinRate;

                extraMinutesText.innerText = `${extraMins} min`;
                extraMinutesText.className = "font-black text-rose-400 text-sm";
                
                extraCostText.innerText = `$${extraCost.toFixed(2)} MXN`;
                extraCostText.className = "font-black text-lg text-rose-400";

                clockContainer.className = "bg-slate-950 border-2 border-rose-500/80 rounded-3xl p-6 sm:p-8 shadow-inner glow-rose transition-colors duration-300";
                cortesiaBadge.className = "inline-flex items-center space-x-1.5 mt-3 bg-rose-500/20 text-rose-400 border border-rose-500/40 text-xs font-bold px-3.5 py-1.5 rounded-full animate-pulse-slow";
                cortesiaBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i><span>¡TIEMPO EXCEDIDO COMPUTANDO RECARGO!</span>`;
            } else {
                extraMinutesText.innerText = `0 min`;
                extraMinutesText.className = "font-bold text-slate-200 text-sm";
                
                extraCostText.innerText = `$0.00 MXN`;
                extraCostText.className = "font-bold text-base text-slate-200";

                clockContainer.className = "bg-slate-950 border-2 border-slate-800 rounded-3xl p-6 sm:p-8 shadow-inner transition-colors duration-300";
                cortesiaBadge.className = "inline-flex items-center space-x-1.5 mt-3 bg-blue-500/20 text-blue-400 border border-blue-500/40 text-xs font-bold px-3.5 py-1.5 rounded-full";
                cortesiaBadge.innerHTML = `<i class="fa-solid fa-shield-halved text-xs"></i><span>Tolerancia Activa (5 min cortesía)</span>`;
            }
        }

        async function finishService() {
            clearInterval(timerInterval);
            endTime = new Date();

            const diffMs = endTime - startTime;
            const totalMinutesReal = Math.floor(diffMs / (1000 * 60));

            let extraMinutes = 0;
            let extraCost = 0;

            if (totalMinutesReal > serviceData.allowedMinutes) {
                extraMinutes = totalMinutesReal - serviceData.allowedMinutes;
                extraCost = extraMinutes * serviceData.perMinRate;
            }

            const baseCost = serviceData.blocks * serviceData.rate30Min;
            const hoursCount = serviceData.blocks / 2;
            const helpersCost = serviceData.helpers * (hoursCount * 200); // $200 MXN por hora por ayudante
            const grandTotal = baseCost + helpersCost + extraCost;

            serviceData.endTimeFormatted = endTime.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            serviceData.totalMinutesReal = totalMinutesReal;
            serviceData.extraMinutes = extraMinutes;
            serviceData.baseCost = baseCost;
            serviceData.helpersCost = helpersCost;
            serviceData.extraCost = extraCost;
            serviceData.grandTotal = grandTotal;

            // Rellenar vista de transparencia
            document.getElementById('summaryVehicle').innerText = serviceData.vehicleName;
            document.getElementById('summaryStartTime').innerText = serviceData.startTimeFormatted;
            document.getElementById('summaryEndTime').innerText = serviceData.endTimeFormatted;
            document.getElementById('summaryTotalDuration').innerText = `${totalMinutesReal} Minutos`;
            document.getElementById('summaryContractedTime').innerText = `${serviceData.contractedMinutes} Minutos`;
            document.getElementById('summaryExtraMinutes').innerText = `${extraMinutes} min`;
            document.getElementById('summaryBasePrice').innerText = `$${baseCost.toLocaleString('es-MX')} MXN`;
            document.getElementById('summaryHelpersPrice').innerText = `$${helpersCost.toLocaleString('es-MX')} MXN`;
            document.getElementById('summaryExtraCost').innerText = `$${extraCost.toFixed(2)} MXN`;
            document.getElementById('summaryGrandTotal').innerText = `$${grandTotal.toFixed(2)} MXN`;

            // Cambiar pantalla
            document.getElementById('activeTimerSection').classList.add('hidden');
            document.getElementById('finalSummarySection').classList.remove('hidden');

            // Insertar registro en Supabase (tabla 'servicios_tiempo')
            try {
                const { error } = await _supabase.from('servicios_tiempo').insert([{
                    fecha: serviceData.date,
                    socio: serviceData.driver,
                    cliente: serviceData.client,
                    vehiculo: serviceData.vehicleName,
                    minutos_contratados: serviceData.contractedMinutes,
                    minutos_reales: totalMinutesReal,
                    minutos_extras: extraMinutes,
                    costo_base: baseCost,
                    costo_ayudantes: helpersCost,
                    costo_extra: extraCost,
                    total_pagado: grandTotal
                }]);

                if (error) {
                    console.error('Error al registrar en Supabase:', error.message);
                }
            } catch (e) {
                console.warn('Excepción de Supabase:', e);
            }
        }

        function sendWhatsAppReport() {
            const msg = `📋 *REPORTE DE SERVICIO LOCAL UINGO*%0A%0A` +
                `👤 *Socio / Chofer:* ${serviceData.driver}%0A` +
                `🏢 *Cliente:* ${serviceData.client}%0A` +
                `📅 *Fecha:* ${serviceData.date}%0A` +
                `🚗 *Vehículo:* ${serviceData.vehicleName}%0A` +
                `⏱️ *Contratado:* ${serviceData.contractedMinutes} min (+5m cortesía)%0A` +
                `🕐 *Llegada:* ${serviceData.startTimeFormatted} | *Cierre:* ${serviceData.endTimeFormatted}%0A` +
                `⏳ *Tiempo Real:* ${serviceData.totalMinutesReal} min (Excedido: ${serviceData.extraMinutes} min)%0A` +
                `💰 *Base Renta:* $${serviceData.baseCost.toLocaleString('es-MX')} MXN%0A` +
                (serviceData.helpers > 0 ? `👥 *Ayudantes Extras:* $${serviceData.helpersCost.toLocaleString('es-MX')} MXN%0A` : '') +
                (serviceData.extraCost > 0 ? `⚠️ *Recargo Tiempo Extra:* $${serviceData.extraCost.toFixed(2)} MXN%0A` : '') +
                `💎 *TOTAL A COBRAR:* *$${serviceData.grandTotal.toFixed(2)} MXN*%0A%0A` +
                `_Reporte oficial verificado mediante Panel de Socios UINGO._`;

            window.open(`https://wa.me/523122416157?text=${msg}`, '_blank');
        }

        function resetApp() {
            document.getElementById('driverName').value = '';
            document.getElementById('clientName').value = '';
            document.getElementById('finalSummarySection').classList.add('hidden');
            document.getElementById('setupSection').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
