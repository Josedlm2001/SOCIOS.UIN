<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UINGO Socio - Cronómetro de Servicios por Tiempo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Supabase Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = 'https://tlcbhbigtxhalgebrwqk.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_bigBIqjdy-EfvKtxS349yA_RcKqFrOA';
        const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-full flex flex-col justify-between p-4 sm:p-6">

    <!-- Header -->
    <header class="max-w-md mx-auto w-full flex justify-between items-center pb-4 border-b border-slate-800">
        <div class="flex items-center space-x-2">
            <div class="bg-amber-500 text-slate-950 font-black px-2.5 py-1 rounded-lg text-lg tracking-wider">
                UINGO
            </div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Panel Socio</span>
        </div>
        <div class="text-right">
            <p class="text-[10px] text-slate-400 font-bold uppercase">Zona Horaria</p>
            <p class="text-xs font-extrabold text-amber-400">CDMX / GDL (UTC-6)</p>
        </div>
    </header>

    <!-- Main Card -->
    <main class="max-w-md mx-auto w-full my-6 bg-slate-800 border border-slate-700 rounded-3xl p-6 shadow-2xl space-y-6">

        <!-- Formulario de Inicio -->
        <div id="setupForm" class="space-y-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-clipboard-user text-amber-500"></i>
                Datos del Servicio Local (Por Tiempo)
            </h2>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Nombre del Socio / Chofer</label>
                <input type="text" id="driverName" placeholder="Ej. Carlos Mendoza" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Nombre del Cliente</label>
                <input type="text" id="clientName" placeholder="Ej. Roberto Gómez" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Fecha</label>
                    <input type="date" id="serviceDate" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-3 text-xs text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Vehículo Asignado</label>
                    <select id="vehicleType" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-3 text-xs text-white focus:outline-none focus:border-amber-500 font-bold">
                        <option value="camioneta">Camioneta 1.2T ($312/30m)</option>
                        <option value="camion">Camión 3T ($936/30m)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Tiempo Solicitado por el Cliente</label>
                <select id="contractedBlocks" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 font-bold text-amber-400">
                    <option value="1">30 Minutos</option>
                    <option value="2">1 Hora (60 min)</option>
                    <option value="3">1 Hora 30 Minutos</option>
                    <option value="4">2 Horas (120 min)</option>
                    <option value="5">2 Horas 30 Minutos</option>
                    <option value="6">3 Horas</option>
                    <option value="8">4 Horas</option>
                    <option value="10">5 Horas</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Ayudantes Extras</label>
                <select id="extraHelpers" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
                    <option value="0">Solo Chofer (Incluido)</option>
                    <option value="1">1 Ayudante Extra ($200/hr)</option>
                    <option value="2">2 Ayudantes Extras ($400/hr)</option>
                    <option value="3">3 Ayudantes Extras ($600/hr)</option>
                </select>
            </div>

            <div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-xs text-amber-300 flex items-start space-x-2">
                <i class="fa-solid fa-clock-stop text-amber-400 mt-0.5"></i>
                <p>El cronómetro se activa al llegar la unidad a la ubicación. Se otorga cortesía de 5 min al inicio y al final antes de computar tiempo extra.</p>
            </div>

            <button onclick="startService()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-4 rounded-2xl shadow-lg transition flex items-center justify-center space-x-2 text-base">
                <i class="fa-solid fa-play"></i>
                <span>LLEGADA A UBICACIÓN - INICIAR</span>
            </button>
        </div>

        <!-- Panel de Cronómetro Activo -->
        <div id="activeTimerSection" class="hidden space-y-6 text-center">
            <div class="bg-slate-900 border border-slate-700 rounded-2xl p-4 text-left text-xs space-y-1">
                <p class="text-slate-400">Cliente: <strong class="text-white" id="displayClientName">-</strong></p>
                <p class="text-slate-400">Chofer: <strong class="text-white" id="displayDriverName">-</strong></p>
                <p class="text-slate-400">Vehículo: <strong class="text-amber-400" id="displayVehicleName">-</strong></p>
                <p class="text-slate-400">Llegada / Inicio: <strong class="text-amber-400" id="displayStartTime">-</strong></p>
                <p class="text-slate-400">Tiempo Solicitado: <strong class="text-emerald-400" id="displayContractedTime">-</strong></p>
            </div>

            <!-- Display Reloj -->
            <div class="bg-slate-950 border-2 border-amber-500/50 rounded-3xl p-6 shadow-inner">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Tiempo Transcurrido</p>
                <div class="text-5xl font-black text-white tracking-wider font-mono" id="timerDisplay">00:00:00</div>
                <div id="cortesiaBadge" class="inline-block mt-3 bg-blue-500/20 text-blue-400 border border-blue-500/40 text-[11px] font-bold px-3 py-1 rounded-full">
                    🛡️ En margen de tolerancia (5 min)
                </div>
            </div>

            <!-- Status Dinámico Excedente -->
            <div id="overtimeCard" class="bg-slate-900 border border-slate-700 rounded-2xl p-4 text-xs space-y-2">
                <div class="flex justify-between">
                    <span class="text-slate-400">Minutos Excedidos:</span>
                    <span class="font-bold text-rose-400" id="extraMinutesText">0 min</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Costo Extra por Tiempo:</span>
                    <span class="font-bold text-rose-400" id="extraCostText">$0.00 MXN</span>
                </div>
            </div>

            <button onclick="finishService()" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-extrabold py-4 rounded-2xl shadow-lg transition flex items-center justify-center space-x-2 text-base">
                <i class="fa-solid fa-stop"></i>
                <span>FINALIZAR TRABAJO</span>
            </button>
        </div>

        <!-- Resumen Final y Transparencia -->
        <div id="finalSummarySection" class="hidden space-y-5">
            <div class="text-center">
                <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-2 text-xl border border-emerald-500/30">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h3 class="text-xl font-extrabold text-white">Servicio Concluido</h3>
                <p class="text-xs text-slate-400 mt-1">Desglose exacto de cobro para Cliente y Socio</p>
            </div>

            <div class="bg-slate-900 border border-slate-700 rounded-2xl p-4 text-xs space-y-3">
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Vehículo Utilizado:</span>
                    <span class="font-bold text-amber-400" id="summaryVehicle">-</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Llegada (Inicio):</span>
                    <span class="font-bold text-white" id="summaryStartTime">-</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Hora de Cierre:</span>
                    <span class="font-bold text-white" id="summaryEndTime">-</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Total Transcurrido:</span>
                    <span class="font-bold text-amber-400" id="summaryTotalDuration">-</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Solicitado:</span>
                    <span class="font-bold text-white" id="summaryContractedTime">-</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Tiempo Extra Cobrable:</span>
                    <span class="font-bold text-rose-400" id="summaryExtraMinutes">0 min</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Cobro Base Inicial:</span>
                    <span class="font-bold text-white" id="summaryBasePrice">$0.00 MXN</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Cargadores Extras:</span>
                    <span class="font-bold text-white" id="summaryHelpersPrice">$0.00 MXN</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800">
                    <span class="text-slate-400">Recargo por Tiempo Extra:</span>
                    <span class="font-bold text-rose-400" id="summaryExtraCost">$0.00 MXN</span>
                </div>
                <div class="flex justify-between text-sm pt-1">
                    <span class="font-extrabold text-white">TOTAL A COBRAR:</span>
                    <span class="font-black text-emerald-400 text-lg" id="summaryGrandTotal">$0.00 MXN</span>
                </div>
            </div>

            <!-- Botones de Acción -->
            <button onclick="sendWhatsAppReport()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-3.5 rounded-2xl shadow-lg transition flex items-center justify-center space-x-2 text-sm">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>ENVIAR REPORTE A UINGO WHATSAPP</span>
            </button>

            <button onclick="resetApp()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3 rounded-2xl transition text-xs">
                Registrar Nuevo Servicio
            </button>
        </div>

    </main>

    <footer class="max-w-md mx-auto w-full text-center text-[10px] text-slate-500">
        UINGO Logística & Fletes © 2026 — Colima / Jalisco, México
    </footer>

    <!-- Lógica JavaScript -->
    <script>
        let startTime = null;
        let endTime = null;
        let timerInterval = null;
        let serviceData = {};

        window.onload = function() {
            const today = new Date();
            document.getElementById('serviceDate').value = today.toISOString().split('T')[0];
        };

        function startService() {
            const driver = document.getElementById('driverName').value.trim();
            const client = document.getElementById('clientName').value.trim();
            const date = document.getElementById('serviceDate').value;
            const vehicle = document.getElementById('vehicleType').value;
            const blocks = parseInt(document.getElementById('contractedBlocks').value);
            const helpers = parseInt(document.getElementById('extraHelpers').value);

            if (!driver || !client) {
                alert("Por favor completa el nombre del chofer y del cliente.");
                return;
            }

            startTime = new Date(); // Hora local México GDL

            const vehicleName = vehicle === 'camioneta' ? 'Camioneta (1.2 Toneladas)' : 'Camión (3 Toneladas)';

            serviceData = {
                driver,
                client,
                date,
                vehicle,
                vehicleName,
                blocks,
                helpers,
                contractedMinutes: blocks * 30,
                startTimeFormatted: startTime.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
            };

            document.getElementById('displayClientName').innerText = client;
            document.getElementById('displayDriverName').innerText = driver;
            document.getElementById('displayVehicleName').innerText = vehicleName;
            document.getElementById('displayStartTime').innerText = serviceData.startTimeFormatted;
            document.getElementById('displayContractedTime').innerText = `${serviceData.contractedMinutes} Minutos`;

            document.getElementById('setupForm').classList.add('hidden');
            document.getElementById('activeTimerSection').classList.remove('hidden');

            timerInterval = setInterval(updateTimerDisplay, 1000);
        }

        function updateTimerDisplay() {
            const now = new Date();
            const diffMs = now - startTime;
            const totalSecs = Math.floor(diffMs / 1000);

            const hrs = String(Math.floor(totalSecs / 3600)).padStart(2, '0');
            const mins = String(Math.floor((totalSecs % 3600) / 60)).padStart(2, '0');
            const secs = String(totalSecs % 60).padStart(2, '0');

            document.getElementById('timerDisplay').innerText = `${hrs}:${mins}:${secs}`;

            const elapsedMins = Math.floor(totalSecs / 60);
            const allowedMins = serviceData.contractedMinutes + 5; // 5 min cortesía
            
            // Tarifa base 30 min según vehículo
            const rate30 = serviceData.vehicle === 'camioneta' ? 312 : 936;
            const costPerMin = rate30 / 30;

            if (elapsedMins > allowedMins) {
                const extraMins = elapsedMins - allowedMins;
                const extraCost = extraMins * costPerMin;
                document.getElementById('extraMinutesText').innerText = `${extraMins} min`;
                document.getElementById('extraCostText').innerText = `$${extraCost.toFixed(2)} MXN`;
                document.getElementById('cortesiaBadge').className = "inline-block mt-3 bg-rose-500/20 text-rose-400 border border-rose-500/40 text-[11px] font-bold px-3 py-1 rounded-full";
                document.getElementById('cortesiaBadge').innerText = "⚠️ TIEMPO EXCEDIDO EN CURSO";
            } else {
                document.getElementById('extraMinutesText').innerText = `0 min`;
                document.getElementById('extraCostText').innerText = `$0.00 MXN`;
            }
        }

        async function finishService() {
            clearInterval(timerInterval);
            endTime = new Date();

            const diffMs = endTime - startTime;
            const totalMinutesReal = Math.floor(diffMs / (1000 * 60));
            const allowedMinutes = serviceData.contractedMinutes + 5; // 5 min cortesía

            const rate30 = serviceData.vehicle === 'camioneta' ? 312 : 936;
            const costPerMin = rate30 / 30;

            let extraMinutes = 0;
            let extraCost = 0;

            if (totalMinutesReal > allowedMinutes) {
                extraMinutes = totalMinutesReal - allowedMinutes;
                extraCost = extraMinutes * costPerMin;
            }

            const baseCost = serviceData.blocks * rate30;
            const hoursCount = serviceData.blocks / 2;
            const helpersCost = serviceData.helpers * (hoursCount * 200);
            const grandTotal = baseCost + helpersCost + extraCost;

            serviceData.endTimeFormatted = endTime.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            serviceData.totalMinutesReal = totalMinutesReal;
            serviceData.extraMinutes = extraMinutes;
            serviceData.baseCost = baseCost;
            serviceData.helpersCost = helpersCost;
            serviceData.extraCost = extraCost;
            serviceData.grandTotal = grandTotal;

            // Rellenar resumen visual de transparencia
            document.getElementById('summaryVehicle').innerText = serviceData.vehicleName;
            document.getElementById('summaryStartTime').innerText = serviceData.startTimeFormatted;
            document.getElementById('summaryEndTime').innerText = serviceData.endTimeFormatted;
            document.getElementById('summaryTotalDuration').innerText = `${totalMinutesReal} Minutos`;
            document.getElementById('summaryContractedTime').innerText = `${serviceData.contractedMinutes} Minutos (+5m cortesía)`;
            document.getElementById('summaryExtraMinutes').innerText = `${extraMinutes} min`;
            document.getElementById('summaryBasePrice').innerText = `$${baseCost.toLocaleString('es-MX')} MXN`;
            document.getElementById('summaryHelpersPrice').innerText = `$${helpersCost.toLocaleString('es-MX')} MXN`;
            document.getElementById('summaryExtraCost').innerText = `$${extraCost.toFixed(2)} MXN`;
            document.getElementById('summaryGrandTotal').innerText = `$${grandTotal.toFixed(2)} MXN`;

            document.getElementById('activeTimerSection').classList.add('hidden');
            document.getElementById('finalSummarySection').classList.remove('hidden');

            // Insertar datos en la tabla 'servicios_tiempo' de Supabase
            try {
                const { error } = await _supabase.from('servicios_tiempo').insert([{
                    fecha: serviceData.date,
                    socio: serviceData.driver,
                    cliente: serviceData.client,
                    vehiculo: serviceData.vehicleName,
                    minutos_contratados: serviceData.contractedMinutes,
                    minutos_reales: totalMinutesReal,
                    minutos_extras: extraMinutes,
                    costo_base: baseCost,
                    costo_ayudantes: helpersCost,
                    costo_extra: extraCost,
                    total_pagado: grandTotal
                }]);

                if (error) console.error('Error al guardar en Supabase:', error.message);
            } catch (e) {
                console.warn('Supabase red error:', e);
            }
        }

        function sendWhatsAppReport() {
            const msg = `📋 *REPORTE DE SERVICIO LOCAL UINGO*%0A%0A` +
                `👤 *Socio / Chofer:* ${serviceData.driver}%0A` +
                `🏢 *Cliente:* ${serviceData.client}%0A` +
                `📅 *Fecha:* ${serviceData.date}%0A` +
                `🚗 *Vehículo:* ${serviceData.vehicleName}%0A` +
                `⏱️ *Contratado:* ${serviceData.contractedMinutes} min%0A` +
                `🕐 *Llegada:* ${serviceData.startTimeFormatted} | *Cierre:* ${serviceData.endTimeFormatted}%0A` +
                `⏳ *Tiempo Real:* ${serviceData.totalMinutesReal} min (Excedido: ${serviceData.extraMinutes} min)%0A` +
                `💰 *Base:* $${serviceData.baseCost.toLocaleString('es-MX')} MXN%0A` +
                (serviceData.helpers > 0 ? `👥 *Ayudantes:* $${serviceData.helpersCost.toLocaleString('es-MX')} MXN%0A` : '') +
                (serviceData.extraCost > 0 ? `⚠️ *Recargo Extra:* $${serviceData.extraCost.toFixed(2)} MXN%0A` : '') +
                `💎 *TOTAL FINAL:* *$${serviceData.grandTotal.toFixed(2)} MXN*%0A%0A` +
                `_Reporte generado automáticamente desde panel de socios._`;

            window.open(`https://wa.me/523122416157?text=${msg}`, '_blank');
        }

        function resetApp() {
            document.getElementById('driverName').value = '';
            document.getElementById('clientName').value = '';
            document.getElementById('finalSummarySection').classList.add('hidden');
            document.getElementById('setupForm').classList.remove('hidden');
        }
    </script>
</body>
</html>
